<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- On a weapon: how well it spears fish. A weapon with dive power above zero is a spear, and only a diver holding one
       takes spearfishing work. Quality scales it like other weapon stats. Category Weapon, not Weapon_Melee: the game shows a
       Weapon_Melee stat only on melee weapons, which would hide it on spearguns (gear tiers ticket 01). -->
  <StatDef>
    <defName>Spearfishing_DivePower</defName>
    <label>dive power</label>
    <description>How well this weapon spears fish underwater. Each dive's chance of a catch is multiplied by it. Only a weapon with dive power can be used for spearfishing.</description>
    <category>Weapon</category>
    <defaultBaseValue>0</defaultBaseValue>
    <minValue>0</minValue>
    <toStringStyle>PercentZero</toStringStyle>
    <showIfUndefined>false</showIfUndefined>
    <displayPriorityInCategory>40</displayPriorityInCategory>
    <parts>
      <li Class="StatPart_Quality">
        <factorAwful>0.8</factorAwful>
        <factorPoor>0.9</factorPoor>
        <factorNormal>1</factorNormal>
        <factorGood>1.05</factorGood>
        <factorExcellent>1.1</factorExcellent>
        <factorMasterwork>1.2</factorMasterwork>
        <factorLegendary>1.3</factorLegendary>
      </li>
    </parts>
  </StatDef>

  <!-- On a pawn: how many fish a diver keeps on the stringer before heading ashore. Gear such as a buoy adds to it. -->
  <StatDef>
    <defName>Spearfishing_StringerCapacity</defName>
    <label>stringer capacity</label>
    <description>How many fish a diver can keep on their stringer during a spearfishing trip. When the stringer is full, the diver heads ashore.</description>
    <category>PawnWork</category>
    <defaultBaseValue>4</defaultBaseValue>
    <minValue>1</minValue>
    <toStringStyle>Integer</toStringStyle>
    <showOnAnimals>false</showOnAnimals>
    <displayPriorityInCategory>3000</displayPriorityInCategory>
  </StatDef>

</Defs>
