<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A neolithic fishing spear, crafted from wood with no research. It is a real weapon, weaker than the vanilla spear.
       Parent is BaseMeleeWeapon, not BaseMeleeWeapon_Sharp, whose default ingredient filter disallows wood logs. -->
  <ThingDef ParentName="BaseMeleeWeapon">
    <defName>Spearfishing_PoleSpear</defName>
    <label>pole spear</label>
    <description>A long wooden pole with a fire-hardened, barbed point, made for spearing fish on a breath-hold dive. It works as a weapon too, though not a very good one.</description>
    <graphicData>
      <texPath>Things/Spearfishing/Weapon/PoleSpear</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Neolithic</techLevel>
    <smeltable>false</smeltable>
    <weaponClasses>
      <li>MeleePiercer</li>
      <li>Neolithic</li>
    </weaponClasses>
    <weaponTags>
      <li>Spearfishing_Spear</li>
    </weaponTags>
    <costList>
      <WoodLog>40</WoodLog>
    </costList>
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <Mass>1.6</Mass>
      <Spearfishing_DivePower>0.6</Spearfishing_DivePower>
    </statBases>
    <equippedAngleOffset>-25</equippedAngleOffset>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
    </comps>
    <tools>
      <li>
        <label>shaft</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>14</power>
        <armorPenetration>0.2</armorPenetration>
        <cooldownTime>2.2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
      <displayPriority>305</displayPriority>
    </recipeMaker>
  </ThingDef>

</Defs>
