<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Industrial fins (gear tiers, ticket 02). Same layer and body part group as the wooden fins, so the two can't be worn
       together. Needs Spearfishing and Biofuel refining (ADR 0012); chemfuel stands in for the plastic and rubber. -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Spearfishing_PlasticFins</defName>
    <label>plastic fins</label>
    <description>A pair of moulded plastic blades with rubber foot pockets. They are longer and stiffer than wooden fins, so a swimmer wearing them is faster in open water and slower to tire than in wooden fins. They do nothing on land.\n\nNeeds the Spearfishing and Biofuel refining research.</description>
    <graphicData>
      <!-- Approved art; see art/plastic-fins/APPROVAL.md. -->
      <texPath>Things/Spearfishing/Apparel/PlasticFins</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costList>
      <Chemfuel>30</Chemfuel>
      <Steel>10</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToMake>3000</WorkToMake>
      <Mass>1</Mass>
      <Flammability>0.6</Flammability>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <Spearfishing_SwimSpeed>0.4</Spearfishing_SwimSpeed>
      <!-- Waves' stat: Rest drains in deep water at Waves' rate divided by this, 1.4 with the fins. -->
      <Waves_SwimStamina>0.4</Waves_SwimStamina>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Feet</li>
      </bodyPartGroups>
      <layers>
        <li>Spearfishing_Fins</li>
      </layers>
      <!-- Item only, no worn graphic, as the wooden fins. No apparel tags: pawn generation must not hand fins to raiders or
           traders' guards. -->
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
    </apparel>
    <recipeMaker>
      <researchPrerequisites>
        <li>Spearfishing_Spearfishing</li>
        <li>BiofuelRefining</li>
      </researchPrerequisites>
      <workSkill>Crafting</workSkill>
      <recipeUsers Inherit="False">
        <li>HandTailoringBench</li>
        <li>ElectricTailoringBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>253</displayPriority>
    </recipeMaker>
  </ThingDef>
</Defs>
